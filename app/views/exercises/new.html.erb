<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h2>新しいエクササイズを作成</h2>
        </div>
        <div class="card-body">
          <%= form_with model: @exercise, local: true do |form| %>
            <% if @exercise.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @exercise.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            
            <div class="mb-3">
              <%= form.label :title, "エクササイズ名", class: "form-label" %>
              <%= form.text_field :title, class: "form-control" %>
            </div>
            
            <div class="mb-3">
              <%= form.label :description, "説明", class: "form-label" %>
              <%= form.text_area :description, class: "form-control", rows: 4 %>
            </div>
            
            <div class="mb-3">
              <%= form.label :duration, "所要時間（分）", class: "form-label" %>
              <%= form.number_field :duration, class: "form-control", min: 1 %>
            </div>
            
            <div class="mb-3">
              <%= form.label :symptom_id, "対象症状", class: "form-label" %>
              <%= form.collection_select :symptom_id, @symptoms, :id, :name, 
                  { prompt: "症状を選択してください" }, 
                  { class: "form-select" } %>
            </div>
            
            <div class="mb-3">
              <%= form.label :category, "カテゴリ", class: "form-label" %>
              <%= form.select :category, 
                  options_for_select(Exercise::CATEGORIES.map { |cat| [cat, cat] }),
                  { prompt: "カテゴリを選択してください" },
                  { class: "form-select" } %>
            </div>
            
            <div class="mb-3">
              <%= form.label :image, "画像", class: "form-label" %>
              <%= form.file_field :image, class: "form-control", accept: "image/*" %>
            </div>
            
            <div class="mb-3">
              <%= form.label :youtube_url, "YouTube URL", class: "form-label" %>
              <%= form.url_field :youtube_url, class: "form-control", 
                  placeholder: "https://www.youtube.com/watch?v=..." %>
            </div>
            
            <div class="mb-3">
              <%= form.label :video_file, "動画ファイル", class: "form-label" %>
              <%= form.file_field :video_file, class: "form-control", accept: "video/*" %>
              <div class="form-text">YouTube URLまたは動画ファイルのどちらかを入力してください</div>
            </div>
            
            <div class="mb-3">
              <%= form.label :instructions, "実施方法", class: "form-label" %>
              <%= form.text_area :instructions, class: "form-control", rows: 3 %>
            </div>
            
            <div class="mb-3">
              <%= form.label :steps, "手順", class: "form-label" %>
              <%= form.text_area :steps, class: "form-control", rows: 3 %>
            </div>
            
            <div class="mb-3 form-check">
              <%= form.check_box :published, class: "form-check-input" %>
              <%= form.label :published, "公開する", class: "form-check-label" %>
            </div>
            
            <div class="d-flex justify-content-between">
              <%= link_to "戻る", exercises_path, class: "btn btn-secondary" %>
              <%= form.submit "エクササイズを作成", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>