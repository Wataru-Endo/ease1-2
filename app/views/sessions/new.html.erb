<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header text-center">
          <h2>ログイン</h2>
        </div>
        <div class="card-body">
          <%= form_with url: login_path, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :email, "メールアドレス", class: "form-label" %>
              <%= form.email_field :email, class: "form-control", required: true %>
            </div>
            
            <div class="mb-3">
              <%= form.label :password, "パスワード", class: "form-label" %>
              <%= form.password_field :password, class: "form-control", required: true %>
            </div>
            
            <div class="d-grid gap-2">
              <%= form.submit "ログイン", class: "btn btn-primary" %>
            </div>
          <% end %>
          
          <!-- 管理者ログインボタン -->
          <div class="mt-4">
            <h6 class="text-center text-muted mb-3">クイックログイン</h6>
            <div class="d-grid gap-2">
              <%= form_with url: login_path, local: true, class: "mb-2" do |form| %>
                <%= form.hidden_field :email, value: "admin@example.com" %>
                <%= form.hidden_field :password, value: "12345678" %>
                <%= form.submit "管理者としてログイン", class: "btn btn-danger" %>
              <% end %>
              
              <%= form_with url: login_path, local: true do |form| %>
                <%= form.hidden_field :email, value: "user@example.com" %>
                <%= form.hidden_field :password, value: "password" %>
                <%= form.submit "一般ユーザーとしてログイン", class: "btn btn-outline-primary" %>
              <% end %>
            </div>
          </div>

          <!-- ゲストログインボタン(パスワードなし) -->
          <% if Rails.env.development? %>
            <div class="mt-4">
              <h6 class="text-center text-muted mb-3">ゲストログイン(パスワード不要)</h6>
              <div class="d-grid gap-2">
                <%= button_to "管理者としてゲストログイン", dev_login_path(role: "admin"), class: "btn btn-danger" %>
                <%= button_to "一般ユーザーとしてゲストログイン", dev_login_path(role: "user"), class: "btn btn-outline-primary" %>
              </div>
            </div>
          <% end %>
          
          <!-- アカウント作成リンク -->
          <div class="text-center mt-4">
            <p class="text-muted">アカウントをお持ちでない方は</p>
            <%= link_to "新規登録", new_user_path, class: "btn btn-outline-success" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>