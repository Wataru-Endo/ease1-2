<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header text-center">
          <h2>セルフケアアプリ</h2>
          <p class="mb-0">ログイン</p>
        </div>
        <div class="card-body">
          <%= form_with url: login_path, method: :post, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :email, "メールアドレス", class: "form-label" %>
              <%= form.email_field :email, class: "form-control", placeholder: "example@email.com" %>
            </div>
            
            <div class="mb-3">
              <%= form.label :password, "パスワード", class: "form-label" %>
              <%= form.password_field :password, class: "form-control" %>
            </div>
            
            <div class="d-grid">
              <%= form.submit "ログイン", class: "btn btn-primary" %>
            </div>
          <% end %>
          
          <div class="text-center mt-3">
            <p>アカウントをお持ちでない方は</p>
            <%= link_to "新規登録", new_user_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
