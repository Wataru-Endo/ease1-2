<div class="container mt-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      <div class="card">
        <div class="card-header">
          <h2><%= @symptom.name %>のセルフケア</h2>
          <p class="text-muted mb-0"><%= @symptom.description %></p>
        </div>
        <div class="card-body">
          <% if @exercises.any? %>
            <div class="row">
              <% @exercises.each do |exercise| %>
                <div class="col-md-6 col-lg-4 mb-4">
                  <div class="card h-100 exercise-card">
                    <div class="card-body">
                      <h5 class="card-title"><%= exercise.title %></h5>
                      <p class="card-text"><%= truncate(exercise.description, length: 100) %></p>
                      <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                          <i class="fas fa-clock me-1"></i><%= exercise.duration %>分
                        </small>
                        <% if exercise.has_video? %>
                          <span class="badge bg-primary">動画あり</span>
                        <% end %>
                      </div>
                    </div>
                    <div class="card-footer">
                      <%= link_to "詳細を見る", exercise_path(exercise), class: "btn btn-primary w-100" %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-exclamation-circle fa-3x text-muted mb-3"></i>
              <h4>エクササイズが見つかりません</h4>
              <p class="text-muted">この症状に対するセルフケアはまだ登録されていません。</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- ナビゲーション -->
      <div class="text-center mt-4">
        <%= link_to "症状選択に戻る", symptoms_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>

<style>
.exercise-card {
  transition: transform 0.2s, box-shadow 0.2s;
}

.exercise-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.1);
}
</style>