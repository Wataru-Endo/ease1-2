<div class="container mt-5">
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <% if @symptom.image.attached? %>
          <%= image_tag @symptom.image, class: "card-img-top", style: "height: 300px; object-fit: cover;" %>
        <% end %>
        <div class="card-body">
          <h1 class="card-title"><%= @symptom.name %></h1>
          <p class="card-text"><%= @symptom.description %></p>
          
          <% if current_user&.admin? %>
            <div class="mt-3">
              <%= link_to "編集", edit_symptom_path(@symptom), class: "btn btn-warning me-2" %>
              <%= link_to "削除", symptom_path(@symptom), 
                  data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                  class: "btn btn-danger" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- 関連エクササイズ表示（既存のコード） -->
  <% if @exercises&.any? %>
    <div class="mb-5">
      <h4 class="mb-3"><i class="fas fa-dumbbell text-warning me-2"></i>推奨エクササイズ</h4>
      <div class="row">
        <% @exercises.each do |exercise| %>
          <div class="col-md-6 mb-3">
            <div class="card border-warning h-100">
              <div class="card-body">
                <h6 class="card-title text-warning">
                  <%= link_to exercise.title, exercise_path(exercise), 
                      class: "text-decoration-none text-warning" %>
                </h6>
                <p class="card-text text-muted">
                  <%= truncate(exercise.description, length: 100) %>
                </p>
                <div class="d-flex justify-content-between">
                  <% if exercise.duration %>
                    <small class="text-muted">
                      <i class="fas fa-clock me-1"></i><%= exercise.duration %>分
                    </small>
                  <% end %>
                  <% if exercise.youtube_url.present? || exercise.video_file.attached? %>
                    <small class="text-success">
                      <i class="fas fa-video me-1"></i>動画あり
                    </small>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="alert alert-info">
      <i class="fas fa-info-circle me-2"></i>
      この症状に関連するエクササイズはまだありません。
    </div>
  <% end %>

  <div class="mt-3">
    <%= link_to "症状一覧に戻る", symptoms_path, class: "btn btn-secondary" %>
  </div>
</div>
