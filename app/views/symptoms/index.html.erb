<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🩺 症状一覧</h1>
    
    <div class="d-flex align-items-center">
      <!-- 管理者のみ症状作成ボタン表示 -->
      <% if current_user&.admin? %>
        <%= link_to "症状作成", new_symptom_path, class: "btn btn-primary me-2" %>
      <% end %>
      
      <div class="me-3">
        <% if current_user %>
          <span class="badge <%= current_user.admin? ? 'bg-danger' : 'bg-primary' %>">
            <%= current_user.role_display %>
          </span>
          <%= current_user.name %>
        <% end %>
      </div>
      
    </div>
  </div>
  
  <!-- 権限に応じたメッセージ -->
  <% if current_user&.admin? %>
    <div class="alert alert-danger mb-4">
      <strong>管理者モードです。</strong> 症状の編集が可能です。
    </div>
  <% else %>
    <div class="alert alert-primary mb-4">
      <strong>ユーザーモードです。</strong> 症状の閲覧が可能です。
    </div>
  <% end %>
  
  <!-- 症状一覧 -->
  <div class="row">
    <% @symptoms.each do |symptom| %>
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="card h-100">
          <% if symptom.image.attached? %>
            <%= image_tag symptom.image, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
          <% else %>
            <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
              <i class="fas fa-stethoscope fa-3x text-muted"></i>
            </div>
          <% end %>
          
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to symptom.name, symptom_path(symptom), class: "text-decoration-none" %>
            </h5>
            <p class="card-text"><%= truncate(symptom.description, length: 100) if symptom.description %></p>
            
            <div class="d-flex justify-content-between align-items-center mb-2">
              <small class="text-muted">
                <span class="badge bg-success">🩺 症状</span>
              </small>
            </div>
            
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <%= link_to "詳細", symptom_path(symptom), class: "btn btn-sm btn-outline-primary" %>
              </div>
              
              <!-- 管理者のみ編集・削除ボタン表示 -->
              <% if current_user&.admin? %>
                <div>
                  <%= link_to "編集", edit_symptom_path(symptom), class: "btn btn-sm btn-warning me-1" %>
                  <%= link_to "削除", symptom_path(symptom), 
                      data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                      class: "btn btn-sm btn-danger" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
  <% if @symptoms.empty? %>
    <div class="text-center mt-5">
      <h3 class="text-muted">症状がありません</h3>
      <% if current_user&.admin? %>
        <%= link_to "最初の症状を作成", new_symptom_path, class: "btn btn-primary mt-3" %>
      <% end %>
    </div>
  <% end %>
  
  <!-- ナビゲーション -->
  <div class="text-center mt-4">
    <%= link_to "エクササイズ一覧", exercises_path, class: "btn btn-outline-info me-2" %>
    <%= link_to "お気に入り", favorites_path, class: "btn btn-outline-warning" %>
  </div>
</div>

<div class="mt-4 text-center">
  <%= link_to "マイページに戻る", user_path(current_user), class: "btn btn-secondary" %>
</div>

<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>