<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header text-center">
          <h2>プロフィール編集</h2>
        </div>
        <div class="card-body">
          <%= form_with model: @user, local: true do |form| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- プロフィール画像 -->
            <div class="mb-4 text-center">
              <% if @user.avatar.attached? %>
                <%= image_tag @user.avatar, class: "img-fluid rounded-circle mb-3", style: "max-width: 120px;" %>
              <% else %>
                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" 
                     style="width: 120px; height: 120px;">
                  <i class="fas fa-user fa-2x text-secondary"></i>
                </div>
              <% end %>
              <%= form.label :avatar, "プロフィール画像", class: "form-label" %>
              <%= form.file_field :avatar, class: "form-control", accept: "image/*" %>
            </div>

            <!-- 基本情報 -->
            <h5 class="mb-3"><i class="fas fa-user me-2"></i>基本情報</h5>
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :name, "お名前", class: "form-label" %>
                <%= form.text_field :name, class: "form-control" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= form.label :email, "メールアドレス", class: "form-label" %>
                <%= form.email_field :email, class: "form-control" %>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :birth_date, "生年月日", class: "form-label" %>
                <%= form.date_field :birth_date, class: "form-control" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= form.label :age, "年齢", class: "form-label" %>
                <%= form.number_field :age, class: "form-control", min: 0, max: 120 %>
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :gender, "性別", class: "form-label" %>
              <%= form.select :gender, 
                    options_for_select([
                      ['選択してください', ''],
                      ['男性', 'male'],
                      ['女性', 'female'],
                      ['その他', 'other'],
                      ['回答しない', 'prefer_not_to_say']
                    ], @user.gender), 
                    {}, { class: "form-select" } %>
            </div>

            <!-- 身体情報 -->
            <h5 class="mb-3 mt-4"><i class="fas fa-weight me-2"></i>身体情報</h5>
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :height, "身長 (cm)", class: "form-label" %>
                <%= form.number_field :height, class: "form-control", step: 0.1, min: 50, max: 250, placeholder: "例: 170.5" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= form.label :weight, "体重 (kg)", class: "form-label" %>
                <%= form.number_field :weight, class: "form-control", step: 0.1, min: 20, max: 300, placeholder: "例: 65.0" %>
              </div>
            </div>

            <!-- お困りの症状 -->
            <h5 class="mb-3 mt-4"><i class="fas fa-stethoscope me-2"></i>お困りの症状</h5>
            <div class="mb-3">
              <%= form.label :primary_symptom, "主なお困りの症状", class: "form-label" %>
              <%= form.select :primary_symptom, 
                    options_for_select([
                      ['選択してください', ''],
                      ['腰痛', 'back_pain'],
                      ['肩こり', 'shoulder_stiffness'],
                      ['首の痛み', 'neck_pain'],
                      ['膝の痛み', 'knee_pain'],
                      ['頭痛', 'headache'],
                      ['眼精疲労', 'eye_strain'],
                      ['手首の痛み', 'wrist_pain'],
                      ['猫背', 'poor_posture'],
                      ['むくみ', 'swelling'],
                      ['その他', 'other']
                    ], @user.primary_symptom), 
                    {}, { class: "form-select" } %>
            </div>

            <!-- パスワード変更 -->
            <h5 class="mb-3 mt-4"><i class="fas fa-lock me-2"></i>パスワード変更</h5>
            <div class="row">
              <div class="col-md-6 mb-3">
                <%= form.label :password, "新しいパスワード（変更しない場合は空欄）", class: "form-label" %>
                <%= form.password_field :password, class: "form-control", placeholder: "6文字以上" %>
              </div>
              <div class="col-md-6 mb-3">
                <%= form.label :password_confirmation, "パスワード確認", class: "form-label" %>
                <%= form.password_field :password_confirmation, class: "form-control" %>
              </div>
            </div>
            
            <div class="d-grid gap-2 mt-4">
              <%= form.submit "更新", class: "btn btn-primary btn-lg" %>
              <%= link_to "キャンセル", user_path(@user), class: "btn btn-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>