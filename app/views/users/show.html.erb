<div class="container mt-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h2>プロフィール</h2>
          <%= button_to "ログアウト", logout_path, method: :delete, 
                        class: "btn btn-outline-danger btn-sm",
                        confirm: "ログアウトしますか？" %>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-4 text-center">
              <% if @user.avatar.attached? %>
                <%= image_tag @user.avatar, class: "img-fluid rounded-circle", style: "max-width: 150px;" %>
              <% else %>
                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" 
                     style="width: 150px; height: 150px; margin: 0 auto;">
                  <i class="fas fa-user fa-3x text-secondary"></i>
                </div>
              <% end %>
            </div>
            <div class="col-md-8">
              <h4><%= @user.name %></h4>
              <p class="text-muted"><%= @user.email %></p>
              
              <div class="mt-4">
                <%= link_to "プロフィール編集", edit_user_path(@user), class: "btn btn-primary" %>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- メニューボタン -->
      <div class="row mt-4">
        <div class="col-md-6 mb-3">
          <div class="card text-center h-100">
            <div class="card-body">
              <i class="fas fa-search fa-3x text-primary mb-3"></i>
              <h5>症状を選ぶ</h5>
              <p class="text-muted">お困りの症状を選択</p>
              <%= link_to "症状選択", symptoms_path, class: "btn btn-primary" %>
            </div>
          </div>
        </div>
        <div class="col-md-6 mb-3">
          <div class="card text-center h-100">
            <div class="card-body">
              <i class="fas fa-heart fa-3x text-danger mb-3"></i>
              <h5>お気に入り</h5>
              <p class="text-muted">お気に入りのセルフケア</p>
              <%= link_to "お気に入り一覧", favorites_path, class: "btn btn-danger" %>
            </div>
          </div>
        </div>
      </div>
      
      <div class="row">
        <div class="col-md-6 mb-3">
          <div class="card text-center h-100">
            <div class="card-body">
              <i class="fas fa-calendar fa-3x text-success mb-3"></i>
              <h5>スケジュール</h5>
              <p class="text-muted">スケジュール管理</p>
              <%= link_to "スケジュール", "#", class: "btn btn-success" %>
            </div>
          </div>
        </div>
        <div class="col-md-6 mb-3">
          <div class="card text-center h-100">
            <div class="card-body">
              <i class="fas fa-dumbbell fa-3x text-warning mb-3"></i>
              <h5>セルフケア一覧</h5>
              <p class="text-muted">全てのエクササイズ</p>
              <%= link_to "エクササイズ一覧", exercises_path, class: "btn btn-warning" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>