<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow">
        <div class="card-header bg-success text-white text-center">
          <h2><i class="fas fa-user-plus me-2"></i>新規登録</h2>
        </div>
        <div class="card-body">
          <%= form_with model: @user, local: true do |form| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= form.label :name, "お名前", class: "form-label" %>
              <%= form.text_field :name, class: "form-control", placeholder: "例: 山田太郎" %>
            </div>
            
            <div class="mb-3">
              <%= form.label :email, "メールアドレス", class: "form-label" %>
              <%= form.email_field :email, class: "form-control", placeholder: "例: user@example.com" %>
            </div>
            
            <div class="mb-3">
              <%= form.label :password, "パスワード", class: "form-label" %>
              <%= form.password_field :password, class: "form-control", placeholder: "8文字以上で入力" %>
            </div>
            
            <div class="mb-3">
              <%= form.label :password_confirmation, "パスワード確認", class: "form-label" %>
              <%= form.password_field :password_confirmation, class: "form-control", placeholder: "もう一度パスワードを入力" %>
            </div>
            
            <div class="d-grid">
              <%= form.submit "アカウント作成", class: "btn btn-success" %>
            </div>
          <% end %>
          
          <!-- ログインリンク -->
          <div class="text-center mt-3">
            <p class="text-muted">既にアカウントをお持ちの方は</p>
            <%= link_to "ログインはこちら", login_path, class: "btn btn-outline-primary" %>
          </div>
        </div>
        
        <!-- トップページに戻るボタン -->
        <div class="card-footer text-center bg-light">
          <%= link_to root_path, class: "btn btn-link text-muted" do %>
            <i class="fas fa-arrow-left me-2"></i>トップページに戻る
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>