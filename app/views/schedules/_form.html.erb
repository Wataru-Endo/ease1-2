<%= form_with model: @schedule, local: true do |form| %>
  <% if @schedule.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @schedule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :exercise_id, "エクササイズ", class: "form-label" %>
    <%= form.collection_select :exercise_id, @exercises, :id, :title, { prompt: "選択してください" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :scheduled_at, "日時", class: "form-label" %>
    <%= form.datetime_field :scheduled_at, class: "form-control" %>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :completed, class: "form-check-input" %>
    <%= form.label :completed, "完了", class: "form-check-label" %>
  </div>

  <%= form.submit "保存", class: "btn btn-primary" %>
  <%= link_to "キャンセル", schedules_path, class: "btn btn-secondary" %>
<% end %>
